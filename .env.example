# URL base del backend usada por la app (Expo)
EXPO_PUBLIC_API_BASE_URL=http://TU_IP_LOCAL:3001

# # Token opcional para autenticar requests contra el backend si BACKEND_API_TOKEN esta configurado.
EXPO_PUBLIC_BACKEND_API_TOKEN=

# # Timeout maximo para enviar/radicar (ms). Debe ser mayor al PLAYWRIGHT_TIMEOUT_MS del backend.
EXPO_PUBLIC_SUBMIT_TIMEOUT_MS=

# # Timeout para consultas de seguimiento (ms).
EXPO_PUBLIC_STATUS_TIMEOUT_MS=

# Backoff de seguimiento (produccion)
EXPO_PUBLIC_STATUS_POLL_BASE_MS=
EXPO_PUBLIC_STATUS_POLL_MAX_MS=
EXPO_PUBLIC_STATUS_POLL_JITTER_PCT=
EXPO_PUBLIC_STATUS_POLL_MAX_ELAPSED_MS=
EXPO_PUBLIC_STATUS_POLL_MAX_ATTEMPTS=4
EXPO_PUBLIC_STATUS_POLL_MAX_CONSECUTIVE_ERRORS=
EXPO_PUBLIC_STATUS_RESUME_STALE_MS=
