{
  "name": "pq-ia-app",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "setup": "npm install && cd backend && npm install && npx playwright install chromium",
    "local:setup": "cd backend && npm run local:setup",
    "local:setup:fast": "cd backend && npm run local:setup",
    "local:backend": "cd backend && npm run dev",
    "dev": "concurrently -n backend,app -c cyan,magenta \"npm run backend:dev\" \"npm run app:dev\"",
    "backend:dev": "cd backend && npm run dev",
    "app:dev": "expo start --dev-client",
    "app:dev:lan": "expo start --dev-client --lan",
    "app:dev:tunnel": "expo start --dev-client --tunnel",
    "android:reverse": "adb reverse tcp:8081 tcp:8081 && adb reverse tcp:3001 tcp:3001",
    "app:dev:win": "npm run android:reverse && npm run app:dev:lan",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web"
  },
  "dependencies": {
    "@expo-google-fonts/sora": "^0.4.2",
    "expo-dev-client": "~6.0.20",
    "expo": "~54.0.0",
    "expo-font": "~14.0.11",
    "expo-image-picker": "~17.0.10",
    "expo-linear-gradient": "~15.0.8",
    "expo-location": "~19.0.8",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-maps": "1.20.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-webview": "13.15.0"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.1.10",
    "concurrently": "^9.2.1",
    "typescript": "~5.9.2"
  },
  "private": true
}
