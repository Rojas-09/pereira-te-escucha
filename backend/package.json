{
  "name": "pereira-pqrs-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "local:setup": "node scripts/local-setup.cjs",
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "worker": "node src/worker-entry.js",
    "check": "node -e \"console.log('ok')\"",
    "test": "DATABASE_URL=postgresql://test:test@localhost:5432/test node --test 'src/**/*.test.js' 'tests/**/*.test.js'",
    "test:unit": "DATABASE_URL=postgresql://test:test@localhost:5432/test node --test 'src/**/*.test.js'",
    "test:integration": "DATABASE_URL=postgresql://test:test@localhost:5432/test node --test 'tests/**/*.test.js'"
  },
  "dependencies": {
    "@sentry/node": "^10.57.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^8.3.1",
    "file-type": "^22.0.1",
    "helmet": "^8.0.0",
    "multer": "^2.0.2",
    "pg": "^8.20.0",
    "pino-http": "^10.4.0",
    "playwright": "^1.53.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "supertest": "^7.2.2"
  }
}
