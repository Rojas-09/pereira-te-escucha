{
  "expo": {
    "name": "Pereira Te Escucha",
    "slug": "pq-ia-app",
    "scheme": "pqiaapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#e8f7f2"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.INTERNET"
      ],
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "pan",
      "package": "com.rojas09.pqiaapp"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-dev-client",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Permite adjuntar fotos como evidencia para tu PQRD.",
          "cameraPermission": "Permite tomar fotos para adjuntar evidencia de tu caso."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Permite ubicar en el mapa el punto exacto de tu solicitud ciudadana."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "b4a71a94-41e8-453b-ae7c-ebd17d167d1f"
      }
    },
    "owner": "rojas_09"
  }
}
